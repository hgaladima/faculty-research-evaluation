{
  "name": "Python 3",
  // Or use a Dockerfile or Docker Compose file. More info: https://containers.dev/guide/dockerfile
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "faculty_research_webapp/README.md",
        "faculty_research_webapp/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  "updateContentCommand": "pip3 install --user -r faculty_research_webapp/requirements.txt && echo 'Packages installed'",
  // Started from the app folder so its .streamlit/config.toml (theme, fonts, localhost-only) applies.
  // Streamlit's CORS and XSRF protections stay on; the Codespaces forwarding address is named as the
  // one allowed browser origin. Use the example profiles here: saved evaluations would live in the Codespace.
  "postAttachCommand": {
    "server": "cd faculty_research_webapp && streamlit run app.py --browser.serverAddress \"$CODESPACE_NAME-8501.$GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN\""
  },
  "portsAttributes": {
    "8501": {
      "label": "Application",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
